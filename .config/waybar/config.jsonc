{
  "position": "top",
  "modules-left": ["custom/arch", "hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "power-profiles-daemon", "custom/power"],
  "custom/arch": {
    "format": "  󰣇 ",
    "tooltip": false, 
    "on-click": "hyprmod"
  },
  "hyprland/workspaces": {
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    }
  },
  "clock": {
    "format": " {:%A %H:%M} ",
    "tooltip": false
  },
  "pulseaudio": {
    "format": " {icon} ",
    "format-icons": {
      "default": [" ", " ", " "]
    },
    "scroll-step": 5,
    "tooltip-format": " {volume}% ",
    "on-click": "kitty zsh -ic 'wiremix'"
  },
  "network": {
    "format": " 󰤥  ",
    "tooltip-format": " {essid} ",
    "on-click": "kitty zsh -ic 'nmtui'"
  },
  "battery": {
    "format": " {icon} ",
    "format-icons": [" ", " ", " ", " ", " "],
    "tooltip-format": " {capacity}% "
  },
  "power-profiles-daemon": {
    "format": " {icon} ",
    "format-icons": {
      "default": " ",
      "performance": " ",
      "balanced": " ",
      "power-saver": " "
    },
    "tooltip": false
  },
  "custom/power": {
    "format": "   ",
    "tooltip": false,
    "on-click": "wlogout"
  },
}

