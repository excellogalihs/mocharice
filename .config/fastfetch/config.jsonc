{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "#cba6f7", 
      "2": "#cba6f7"
    },
    "type": "small"
  },
  "display": {
    "key": {
      "width": 3
    }
  },
  "modules": [
    {
      "key": " ",
      "keyColor": "#cba6f7",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "󰅐 ",
      "keyColor": "#cba6f7",
      "type": "uptime",
    },
    {
      "key": " ",
      "keyColor": "#cba6f7",
      "type": "kernel",
      "format": "linux",
    },
    {
      "key": "󰣇 ",
      "keyColor": "#cba6f7",
      "type": "os",
      "format": "arch btw",
    },
    {
      "key": " ",
      "keyColor": "#cba6f7",
      "type": "shell",
      "format": "zsh",
    },
    {
      "key": " ",
      "keyColor": "#cba6f7",
      "type": "terminal",
      "format": "kitty",
    },
    {
      "key": " ",
      "keyColor": "#cba6f7",
      "type": "colors",
      "symbol": "circle",
    }
  ]
}
